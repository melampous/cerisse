# Test-1853 Run 165 single-nozzle grid qualification from chk04000.
# This profile preserves the checkpoint domain and base resolution.  The L0
# BoxArray remains the one stored in the checkpoint; only rebuilt L1/L2 grids
# can benefit immediately from the larger boxes below.
max_step  = 4100
stop_time = 1.0
cfl       = 0.10

# SSPRK(4,3), matching the pure shared-GP candidate.
cns.order_rk  = 3
cns.stages_rk = 4
cns.lo_bc = 1 2 2
cns.hi_bc = 2 2 2
cns.nstep_screen_output = 10
cns.verbose = 0
cns.record_stats = 0
cns.do_reflux = 1
cns.strict_positivity = 1
# Integration-gate limitation: the current 3-D shared-face positivity limiter
# aborts when enabled, and stage_positivity is not a substitute for it.
cns.stage_positivity = 0
cns.stage_positivity_verbose = 0
cns.soft_positivity = 0
cns.ibm_positivity_flux_limiter = 0
cns.ibm_positivity_flux_limiter_verbose = 0

# Pure shared-GP full-cell path.  All cut-control and crossing surrogates stay
# disabled.  The launch manifest must report pure_shared_gp_full_cartesian.
cns.llf_ibm_face_local_crossing = 0
cns.llf_ibm_wall_matched_crossing = 0
cns.llf_ibm_conservative_crossing = 0
cns.llf_ibm_fluid_shell = 0
cns.llf_ibm_shifted_shell = 0
cns.afd_ibm_face_local_crossing = 0
cns.afd_ibm_crossing_wls = 0
cns.afd_ibm_conservative_crossing = 0
cns.afd_ibm_patch_conservative_crossing = 0
cns.afd_ibm_fluid_shell = 0
cns.afd_ibm_shifted_shell = 0

ib.filename = ../../../geometry/test1853/outputs/ibm_prepared/test1853_run165_single_master_SI/test1853_run165_single_master_SI.stl
ib.move = 0
ib.plot_surf = 1
ib.surf_int = 100
ib.surf_file = output/run165/surface
ib.skip_validation = 0
ib.amr_support_buffer = 1
ib.amr_support_audit = 1
ib.amr_support_strict = 1
ib.timing = 1
ib.timing_detail = 0
ib.timing_warn_seconds = 60.0

geometry.is_periodic = 0 0 0
geometry.coord_sys = 0
geometry.prob_lo = -0.192 -0.192 -0.192
geometry.prob_hi =  0.384  0.192  0.192

amr.n_cell = 256 176 176
amr.max_level = 2
amr.ref_ratio = 2 2

# H100 layout: coalesce L1 while retaining an 8-cell L2 alignment unit near
# the nozzle.  A blanket L2 blocking factor of 32 can over-cover the 12.4 mm
# pure-fluid gap and is therefore intentionally prohibited here.
amr.regrid_int = 16 16
amr.blocking_factor = 16 16 8
amr.max_grid_size = 128 128 64
amr.n_error_buf = 8 4
amr.grid_eff = 0.75
DistributionMapping.strategy = SFC

prob.startup_front_x = -0.0525
prob.expected_run_id = 165
prob.jet_enabled = 1

amr.plot_files_output = 1
amr.plot_file = output/run165/plt
amr.plot_int = 25
amr.derive_plot_vars = pressure velocity temperature
amr.v = 1
amr.run_log = output/run165/runlog
amr.grid_log = output/run165/gridlog
amr.checkpoint_files_output = 1
amr.check_file = output/run165/chk
amr.check_int = 100

# The first grid-qualification run may override both diagnostics to one.  They
# should be zero for timing because they materially increase memory traffic.
cns.llf_fallback_mask_diagnostics = 0
cns.regrid_prolongation_diagnostics = 0

amrex.the_arena_is_managed = 0
amrex.abort_on_out_of_gpu_memory = 1
amrex.use_gpu_aware_mpi = 0
