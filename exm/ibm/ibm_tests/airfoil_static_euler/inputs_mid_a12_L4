#------------------------------------------------------------------------------#
#  L4 convergence case: mid_a12 with max_level = 4 (finest dx halved).
#  Everything else identical to inputs_mid_a12 so L3 vs L4 comparison is
#  apples-to-apples for CL/CD/Cm/x_cp and β.
#------------------------------------------------------------------------------#
max_step  = 10000
stop_time = 1.0e-2
cfl = 0.25

cns.order_rk  = 3
cns.stages_rk = 3
cns.lo_bc = 1 2
cns.hi_bc = 2 2
cns.nstep_screen_output = 10
cns.verbose = 1

ib.filename = diamond_wedge_mid_a12.dat
ib.move = 0
ib.plot_surf = 1
ib.surf_file = ./surf_mid_a12_L4/surf
ib.surf_int  = 100

geometry.is_periodic = 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = -0.5  -0.7
geometry.prob_hi     =  0.8   0.7
amr.n_cell           = 512   544

amr.max_level       = 4
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 5
amr.blocking_factor = 16
amr.max_grid_size   = 128
amr.n_error_buf     = 2
amr.grid_eff        = 0.80

amr.plot_files_output = 1
amr.plot_file         = ./plot_mid_a12_L4/plt
amr.plot_int          = 250
amr.derive_plot_vars  = pressure velocity temperature density
amr.v = 1

amr.checkpoint_files_output = 0
amrex.the_arena_is_managed  = 0
