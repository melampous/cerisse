# ---------------------------------------------------------------
# 2D Axisymmetric SRP Run-165 — GPU-tuned inputs (RTX 4090, 16GB)
# ---------------------------------------------------------------
#  Single-GPU run (mpirun -np 1). AMR grid tuned for GPU throughput:
#    - few large patches (max_grid_size=512, blocking_factor=32)
#    - high grid_eff (0.95) so each level stays as a handful of boxes
#    - regrid_int >> 1 to amortise regrid/packing overhead
# ---------------------------------------------------------------

max_step            = 40000
stop_time           = 2.0e-3

# ---- Geometry : 2-D axisymmetric (RZ) ----
geometry.is_periodic = 0  0
geometry.coord_sys   = 1            # 1 = RZ
geometry.prob_lo     = 0.0   0.0
geometry.prob_hi     = 0.12  0.16

# ---- Base grid : 192 x 256 = 49k cells, dr=dz=6.25e-4 m ----
amr.n_cell           = 192  256

# ---- BCs ----
#   1 = user bcnormal , 2 = outflow , 3 = symmetry
cns.lo_bc = 3  1      # r=0 symmetry , z-lo jet/outflow
cns.hi_bc = 2  1      # r-hi outflow , z-hi M=4.6 freestream inflow

# ---- Time stepping ----
cfl                   = 0.3
cns.dt_cutoff         = 5.e-20
cns.do_reflux         = 1
cns.order_rk          = 3
cns.stages_rk         = 3

# ---- AMR (GPU-friendly: few big patches) ----
amr.max_level         = 3
amr.ref_ratio         = 2  2  2  2
amr.regrid_int        = 20  20  20  20    # amortise regrid cost
amr.blocking_factor   = 32
amr.max_grid_size     = 512 512 512 512   # keep each level as 1-4 boxes
amr.n_error_buf       = 8  8  8  8        # wider buffer → less re-regridding
amr.grid_eff          = 0.95              # tolerate over-refinement for fewer boxes

# ---- I/O ----
amr.check_file        = chk
amr.check_int         = 5000
amr.plot_file         = plt
amr.plot_int          = 500
amr.derive_plot_vars  = pressure x_velocity y_velocity magvel MachNumber

# ---- AMReX / GPU ----
amrex.the_arena_is_managed = 0    # pure device memory (faster than UM)
amr.v                 = 1
cns.v                 = 1
cns.nstep_screen_output = 100
