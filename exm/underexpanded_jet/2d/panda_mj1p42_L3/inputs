amr.ref_ratio       = 2 2 2
amr.regrid_int      = 20
amr.blocking_factor = 32
amr.max_grid_size   = 128 256 256 256
amr.n_error_buf     = 2 2 2 2
amr.grid_eff        = 0.85

#-------------------------------- PLOTFILES ----------------------------------#
