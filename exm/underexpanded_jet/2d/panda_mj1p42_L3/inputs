#==============================================================================
#  2D Axisymmetric (RZ) Jet — NPR_0=10.0, pe/pa~5.283
#  Same nozzle (D_e=10mm) and ambient (p=101325 Pa, T=300K) as 3D case
#  Dimension mapping:  r → x-direction ∈ [0, 0.06]
#                      z → y-direction ∈ [0, 0.24]
#==============================================================================
max_step  = 60000
stop_time = 6.0e-3
cfl = 0.3

cns.order_rk  = 3
cns.stages_rk = 3

# BC: x(r)-lo = Symmetry(3), x(r)-hi = Outflow(2),
#     y(z)-lo = Inflow(1) = Jet,  y(z)-hi = Outflow(2)
cns.lo_bc = 3 1
cns.hi_bc = 2 2
cns.nstep_screen_output = 100
cns.verbose = 1

#--------------------------- COMPUTATIONAL DOMAIN ----------------------------#
geometry.is_periodic = 0 0
geometry.coord_sys   = 1           # 1 = RZ axisymmetric
geometry.prob_lo     = 0.0  0.0
geometry.prob_hi     = 0.06 0.24   # r_max=60mm (6 De), z_max=240mm (24 De)
amr.n_cell           = 96   384    # base = 3D L0 (0.625 mm)

#------------------------------- REFINEMENT ----------------------------------#
