max_step  = 400000
stop_time = 6.0e-3
cfl = 0.3

cns.order_rk  = 3
cns.stages_rk = 3

cns.lo_bc = 3 1
cns.hi_bc = 2 2
cns.nstep_screen_output = 200
cns.verbose = 1

geometry.is_periodic = 0 0
geometry.coord_sys   = 1
geometry.prob_lo     = 0.0  0.0
geometry.prob_hi     = 0.12 0.48     # r_max=120mm (12 De), z_max=480mm (48 De)
amr.n_cell           = 192  768      # dx=0.625 mm (same as standard L0)

amr.max_level       = 3
amr.ref_ratio       = 2 2 2
amr.regrid_int      = 20
amr.blocking_factor = 32
amr.max_grid_size   = 128 256 256 256
amr.n_error_buf     = 2 2 2 2
amr.grid_eff        = 0.85

amr.plot_files_output = 1
amr.plot_file         = ./plot/plt
amr.plot_per          = 1.0e-4       # every 0.1 ms -> ~60 plt over 6 ms
amr.derive_plot_vars  = pressure velocity temperature
amr.v = 1

amr.checkpoint_files_output = 1
amr.check_int  = 5000
amr.check_file = ./plot/chk

amrex.the_arena_is_managed = 0
