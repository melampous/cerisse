#!/bin/bash
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=00:30:00
#PBS -N cmp_npr3_visc
#PBS -o compile.out
#PBS -e compile.err

cd $PBS_O_WORKDIR
module load tools/prod
module load GCC/13.3.0
module load OpenMPI/5.0.3-GCC-13.3.0
module load CUDA/12.6.0

echo "=== Compile 3d_npr3_visc GPU ==="
echo "Host: $(hostname)"; date
rm -rf tmp_build_dir *.CUDA.ex
time make -f GNUmakefile.gpu -j4 2>&1 | tail -20
ls -lh main3d.gnu.TPROF.MPI.CUDA.ex 2>/dev/null && echo BUILD_OK || echo BUILD_FAILED
date
